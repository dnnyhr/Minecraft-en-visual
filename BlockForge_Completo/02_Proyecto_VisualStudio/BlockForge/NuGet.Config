<?xml version="1.0" encoding="utf-8"?>
<!-- Garantiza que Visual Studio descargue los paquetes desde nuget.org,
     aunque ese origen esté desactivado en la configuración del equipo. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>
