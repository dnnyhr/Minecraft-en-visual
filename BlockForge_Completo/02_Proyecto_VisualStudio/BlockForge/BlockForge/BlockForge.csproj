<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>BlockForge</RootNamespace>
    <AssemblyName>BlockForge</AssemblyName>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <Product>BlockForge</Product>
    <Version>4.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Database\01_CrearBaseDatos.sql" />
    <EmbeddedResource Include="Database\02_MigrarVersion2.sql" />
    <EmbeddedResource Include="Database\03_MigrarVersion3.sql" />
    <EmbeddedResource Include="Database\04_MigrarVersion4.sql" />
  </ItemGroup>

</Project>
